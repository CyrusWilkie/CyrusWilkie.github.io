# byte & dune — Caddy config
#
# The site sits behind Pangolin (a reverse proxy / tunnel), so Caddy just
# serves plain HTTP on :80 inside the container and lets Pangolin terminate
# TLS at the edge. If you ever expose this container directly to the internet,
# replace `:80` with your domain (e.g. `cyrus.au`) and Caddy will provision
# a Let's Encrypt certificate automatically.

:80 {
	root * /srv
	encode gzip zstd
	file_server

	# Long-cache fingerprinted assets and the Pagefind index.
	@immutable path /pagefind/* *.css *.js *.svg
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
